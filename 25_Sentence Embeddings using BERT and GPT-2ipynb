        "\n",
        "# Install required libraries:\n",
        "# pip install transformers torch scikit-learn\n",
        "\n",
        "import torch\n",
        "import numpy as np\n",
        "from transformers import AutoTokenizer, AutoModel\n",
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "\n",
        "# 1. Sample Sentences\n",
        "sentences = [\n",
        "    \"I love machine learning\",\n",
        "    \"Artificial intelligence is interesting\",\n",
        "    \"I enjoy playing cricket\"\n",
        "]\n",
        "\n",
        "# 2. Load BERT Model\n",
        "bert_name = \"bert-base-uncased\"\n",
        "\n",
        "bert_tokenizer = AutoTokenizer.from_pretrained(bert_name)\n",
        "bert_model = AutoModel.from_pretrained(bert_name)\n",
        "\n",
        "# 3. Generate BERT Sentence Embeddings\n",
        "def get_bert_embeddings(sentences):\n",
        "    inputs = bert_tokenizer(\n",
        "        sentences,\n",
        "        padding=True,\n",
        "        truncation=True,\n",
        "        return_tensors=\"pt\"\n",
        "    )\n",
        "\n",
        "    bert_model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = bert_model(**inputs)\n",
        "\n",
        "    # Mean pooling of token embeddings\n",
        "    embeddings = outputs.last_hidden_state.mean(dim=1)\n",
        "\n",
        "    return embeddings.numpy()\n",
        "\n",
        "bert_embeddings = get_bert_embeddings(sentences)\n",
        "\n",
        "print(\"BERT Embeddings:\")\n",
        "print(bert_embeddings.shape)\n",
        "\n",
        "# 4. Load GPT-2 Model\n",
        "gpt_name = \"gpt2\"\n",
        "\n",
        "gpt_tokenizer = AutoTokenizer.from_pretrained(gpt_name)\n",
        "gpt_tokenizer.pad_token = gpt_tokenizer.eos_token\n",
        "\n",
        "gpt_model = AutoModel.from_pretrained(gpt_name)\n",
        "gpt_model.config.pad_token_id = gpt_tokenizer.pad_token_id\n",
        "\n",
        "# 5. Generate GPT-2 Sentence Embeddings\n",
        "def get_gpt_embeddings(sentences):\n",
        "    inputs = gpt_tokenizer(\n",
        "        sentences,\n",
        "        padding=True,\n",
        "        truncation=True,\n",
        "        return_tensors=\"pt\"\n",
        "    )\n",
        "\n",
        "    gpt_model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        outputs = gpt_model(**inputs)\n",
        "\n",
        "    # Mean pooling using attention mask\n",
        "    token_embeddings = outputs.last_hidden_state\n",
        "    mask = inputs[\"attention_mask\"].unsqueeze(-1)\n",
        "\n",
        "    embeddings = (token_embeddings * mask).sum(dim=1)\n",
        "    embeddings = embeddings / mask.sum(dim=1).clamp(min=1)\n",
        "\n",
        "    return embeddings.numpy()\n",
        "\n",
        "gpt_embeddings = get_gpt_embeddings(sentences)\n",
        "\n",
        "print(\"\\nGPT-2 Embeddings:\")\n",
        "print(gpt_embeddings.shape)\n",
        "\n",
        "# 6. Calculate Cosine Similarity\n",
        "bert_similarity = cosine_similarity(bert_embeddings)\n",
        "gpt_similarity = cosine_similarity(gpt_embeddings)\n",
        "\n",
        "# 7. Display Results\n",
        "print(\"\\nBERT Cosine Similarity:\")\n",
        "print(np.round(bert_similarity, 3))\n",
        "\n",
        "print(\"\\nGPT-2 Cosine Similarity:\")\n",
        "print(np.round(gpt_similarity, 3))\n",
        "\n",
        "# 8. Display Embedding Dimensions\n",
