        "# Fix transformers incompatibility by dynamically patching PreTrainedModel correctly\n",
        "from transformers import PreTrainedModel\n",
        "\n",
        "# Overwrite any previous lambda property with a functional getter/setter property\n",
        "def get_tied_weights(self):\n",
        "    if not hasattr(self, \"_all_tied_weights_keys\"):\n",
        "        self._all_tied_weights_keys = {}\n",
        "    return self._all_tied_weights_keys\n",
        "\n",
        "def set_tied_weights(self, val):\n",
        "    self._all_tied_weights_keys = val\n",
        "\n",
        "PreTrainedModel.all_tied_weights_keys = property(get_tied_weights, set_tied_weights)\n",
        "\n",
        "from fastcoref import FCoref\n",
        "\n",
        "# Load Model\n",
        "model = FCoref(device=\"cpu\")\n",
        "\n",
        "# Input Text\n",
        "text = \"Rahul bought a laptop. He uses it every day. Rahul likes his laptop.\"\n",
        "\n",
        "print(\"Original Text:\")\n",
        "print(text)\n",
        "\n",
        "# Perform Coreference Resolution\n",
        "result = model.predict(texts=[text])\n",
        "\n",
        "# Extract Coreference Clusters\n",
        "clusters = result[0].get_clusters(as_strings=True)\n",
        "\n",
        "print(\"\\nCoreference Clusters:\")\n",
        "for cluster in clusters:\n",
        "    print(cluster)\n",
        "\n",
        "print(\"\\nCoreference Resolution Completed Successfully!\")"
